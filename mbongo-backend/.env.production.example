NODE_ENV=production
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mbongo_prod?schema=public"

JWT_ACCESS_SECRET="generate-a-long-random-production-access-secret"
JWT_REFRESH_SECRET="generate-a-long-random-production-refresh-secret"
JWT_SECRET="generate-a-long-random-production-legacy-secret"

PUBLIC_API_URL="https://api.mbongo.cd"
API_URL="https://api.mbongo.cd"
KYC_UPLOAD_DIR="/var/lib/mbongo/kyc"

ADMIN_DEFAULT_PIN="set-only-for-initial-seed-and-rotate-after-login"
