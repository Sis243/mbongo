NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mbongo_dev?schema=public"

# JWT secrets. Use long random values per environment.
# In staging/production, JWT_ACCESS_SECRET and JWT_REFRESH_SECRET are required.
JWT_ACCESS_SECRET="replace-with-dev-access-secret"
JWT_REFRESH_SECRET="replace-with-dev-refresh-secret"
JWT_SECRET="replace-with-legacy-fallback-secret"

# Public URL used to build links for uploaded KYC files.
PUBLIC_API_URL="http://localhost:3000"
API_URL="http://localhost:3000"

# KYC local storage. In staging/prod, mount this on persistent storage or replace with S3 later.
KYC_UPLOAD_DIR="./uploads/kyc"

# Seed-only default admin PIN. Change in staging/prod before seeding.
ADMIN_DEFAULT_PIN="123456"
